# Required: copy your pooled Neon connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Generate a long random value before production use.
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development

# Optional Meta Graph API connection. The platform remains usable without it.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_IG_USER_ID=
